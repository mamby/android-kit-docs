---
layout: null
permalink: /search.json
---
[
{% assign searchable = site.pages | where_exp: 'item', 'item.title' | where_exp: 'item', 'item.search != false' %}
{% for item in searchable %}
  {
    "title": {{ item.title | jsonify }},
    "description": {{ item.description | default: '' | jsonify }},
    "section": {{ item.section | default: 'Documentation' | jsonify }},
    "url": {{ item.url | relative_url | jsonify }},
    "content": {{ item.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
